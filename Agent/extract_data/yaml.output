hape-calculations', 'type': 'ModuleOp'}, {'description': 'Simplify reified shape calculations.', 'dialect': 'torch', 'name': 'torch-simplify-shape-calculations', 'type': 'func::FuncOp'}, {'description': 'Reify dtype calculations.', 'dialect': 'torch', 'name': 'torch-reify-dtype-calculations', 'type': 'ModuleOp'}, {'description': 'Simplify reified dtype calculations.', 'dialect': 'torch', 'name': 'torch-simplify-dtype-calculations', 'type': 'func::FuncOp'}, {'description': 'Drop reified abstract interpretation calculations.', 'dialect': 'torch', 'name': 'torch-drop-abstract-interp-calculations', 'type': 'func::FuncOp'}, {'description': 'Erase the `torch.global_slot.module_initializer` op.', 'dialect': 'torch', 'name': 'torch-erase-module-initializer', 'type': 'ModuleOp'}, {'description': 'Perform simplifications until the backend contract is satisfied.', 'dialect': 'torch', 'name': 'torch-lower-to-backend-contract', 'type': 'ModuleOp'}, {'description': 'Check that program satisfies backend contract.', 'dialect': 'torch', 'name': 'torch-verify-backend-contract-no-decompositions', 'type': 'ModuleOp'}, {'description': 'Ensure that every Reduction.cpp op has a constant reduction axis.', 'dialect': 'torch', 'name': 'torch-restructure-non-constant-axes', 'type': 'func::FuncOp'}, {'description': 'Inlines torch.global_slot ops when it is safe to do so.', 'dialect': 'torch', 'name': 'torch-inline-global-slots', 'type': 'ModuleOp'}, {'description': 'Partial type conversion pass analogous in scope to the upstream `func-bufferize` pass.', 'dialect': 'torch', 'name': 'torch-func-backend-type-conversion-for-stablehlo', 'type': 'ModuleOp'}, {'description': 'Partial type conversion pass analogous in scope to the upstream `func-bufferize` pass.', 'dialect': 'torch', 'name': 'torch-func-backend-type-conversion', 'type': 'ModuleOp'}, {'description': 'Partial type conversion pass analogous in scope to the upstream `func-bufferize` pass.', 'dialect': 'torch', 'name': 'torch-func-backend-